#!/usr/bin/env bash
# Build the apworld (plus the current userscripts) into build/, then install it.
#
#   ./linux-build                 validate, rebuild userscripts, package, install
#   ./linux-build --no-install    stop after build/, touch nothing outside the repo
#   ./linux-build --skip-validate skip solver/validate_apworld.py
#   ./linux-build --skip-scripts  do not rebuild the mapkit/editor userscripts
#
# Install target is the Archipelago worlds dir; override with AP_WORLDS=<dir>.
# The only thing written outside this repo is <worlds>/johnny_upgrade.apworld.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD="$ROOT/build"
PKG="johnny_upgrade"
AP_WORLDS="${AP_WORLDS:-/games/Archipelago/worlds}"

install=1 validate=1 scripts=1
for a in "$@"; do
  case "$a" in
    --no-install) install=0 ;;
    --skip-validate) validate=0 ;;
    --skip-scripts) scripts=0 ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) echo "unknown flag: $a" >&2; exit 2 ;;
  esac
done

cd "$ROOT"

if [ "$validate" = 1 ]; then
  echo "== validating apworld logic"
  python solver/validate_apworld.py
fi

if [ "$scripts" = 1 ]; then
  echo "== rebuilding userscripts"
  node mapkit/build-userscript.js
  node mapeditor/tools/build-editor-userscript.js
fi

echo "== packaging $PKG.apworld"
rm -rf "$BUILD"
mkdir -p "$BUILD"

# Zip built by hand rather than `zip -r` so __pycache__ can never ride along and
# so the archive is reproducible: fixed timestamp, sorted entries.
python3 - "$ROOT/apworld/$PKG" "$BUILD/$PKG.apworld" "$PKG" <<'PY'
import sys, zipfile
from pathlib import Path

src, out, pkg = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3]
files = sorted(p for p in src.rglob('*')
               if p.is_file() and '__pycache__' not in p.parts and p.suffix != '.pyc')
with zipfile.ZipFile(out, 'w', zipfile.ZIP_DEFLATED) as z:
    z.writestr(zipfile.ZipInfo(pkg + '/', (1980, 1, 1, 0, 0, 0)), b'')
    for f in files:
        info = zipfile.ZipInfo(f"{pkg}/{f.relative_to(src).as_posix()}", (1980, 1, 1, 0, 0, 0))
        info.compress_type = zipfile.ZIP_DEFLATED
        info.external_attr = 0o644 << 16
        z.writestr(info, f.read_bytes())
print(f"  {len(files)} files -> {out}")
PY

echo "== copying userscripts"
mkdir -p "$BUILD/scripts"
cp dist/*.user.js "$BUILD/scripts/"
cp client/*.user.js "$BUILD/scripts/"
ls -1 "$BUILD/scripts" | sed 's/^/  /'

if [ "$install" = 1 ]; then
  if [ ! -d "$AP_WORLDS" ]; then
    echo "install target $AP_WORLDS does not exist; skipping install" >&2
    exit 1
  fi
  echo "== installing to $AP_WORLDS"
  cp -f "$BUILD/$PKG.apworld" "$AP_WORLDS/$PKG.apworld"
fi

echo "done"
